<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trace_transfer_view_search" model="ir.ui.view">
        <field name="name">trace.transfer.search</field>
        <field name="model">trace.transfer</field>
        <field name="arch" type="xml">
            <search string="Transfers">
                <field name="name"/>
                <field name="source_batch_id"/>
                <field name="from_party_id"/>
                <field name="to_party_id"/>
                <filter name="incoming" string="Incoming" domain="[('is_recipient', '=', True)]"/>
                <filter name="outgoing" string="Outgoing" domain="[('is_sender', '=', True)]"/>
                <filter name="pending" string="Waiting" domain="[('state', '=', 'pending')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="trace_transfer_view_list" model="ir.ui.view">
        <field name="name">trace.transfer.list</field>
        <field name="model">trace.transfer</field>
        <field name="arch" type="xml">
            <list string="Transfers">
                <field name="name"/>
                <field name="date_requested"/>
                <field name="source_batch_id"/>
                <field name="from_party_id"/>
                <field name="to_party_id"/>
                <field name="quantity"/>
                <field name="unit"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                       decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="trace_transfer_view_form" model="ir.ui.view">
        <field name="name">trace.transfer.form</field>
        <field name="model">trace.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfer">
                <header>
                    <field name="is_sender" invisible="1"/>
                    <field name="is_recipient" invisible="1"/>
                    <button name="action_accept" string="Accept" type="object" class="btn-primary"
                            invisible="state != 'pending' or not is_recipient"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending' or not is_recipient"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'pending' or not is_sender"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="source_batch_id" options="{'no_create': True}" readonly="id"/>
                            <field name="batch_id" invisible="not id"/>
                            <field name="quantity" readonly="id"/>
                            <field name="unit"/>
                        </group>
                        <group>
                            <field name="from_party_id"/>
                            <field name="to_party_id" options="{'no_create': True}" readonly="id"/>
                            <field name="date_requested" invisible="not id"/>
                            <field name="date_responded" invisible="not date_responded"/>
                        </group>
                    </group>
                    <group string="Deal (private to these two parties)">
                        <field name="price"/>
                        <field name="reference"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="trace_transfer_action" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">trace.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- hand-over button on the batch form -->
    <record id="trace_batch_view_form_custody" model="ir.ui.view">
        <field name="name">trace.batch.form.custody</field>
        <field name="model">trace.batch</field>
        <field name="inherit_id" ref="trace_base.trace_batch_view_form"/>
        <field name="arch" type="xml">
            <button name="action_verify_chain" position="before">
                <button name="action_hand_over" string="Hand over" type="object"
                        invisible="not id or not is_holder or state != 'active'"/>
            </button>
        </field>
    </record>
</odoo>
