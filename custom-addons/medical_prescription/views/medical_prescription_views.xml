<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_medication_view_list" model="ir.ui.view">
        <field name="name">medical.medication.list</field>
        <field name="model">medical.medication</field>
        <field name="arch" type="xml">
            <list string="Medications" editable="bottom">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="strength"/>
                <field name="form"/>
            </list>
        </field>
    </record>
    <record id="medical_medication_action" model="ir.actions.act_window">
        <field name="name">Medications</field>
        <field name="res_model">medical.medication</field>
        <field name="view_mode">list</field>
    </record>

    <record id="medical_prescription_view_list" model="ir.ui.view">
        <field name="name">medical.prescription.list</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions">
                <field name="name"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="company_name" string="Institution"/>
                <field name="pharmacy_name" string="Pharmacy"/>
                <field name="state" widget="badge" decoration-success="state == 'dispensed'"
                       decoration-warning="state == 'partial'" decoration-info="state == 'issued'"
                       decoration-muted="state in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="medical_prescription_view_form" model="ir.ui.view">
        <field name="name">medical.prescription.form</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_issue" string="Issue" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="medical_base.group_medical_practitioner"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'issued')" groups="medical_base.group_medical_practitioner"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,partial,dispensed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="patient_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="practitioner_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="encounter_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_name" string="Institution"/>
                            <field name="pharmacy_company_id" options="{'no_create': True}" readonly="state in ('dispensed', 'cancel')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medications" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="medication_id" options="{'no_create': True}"/>
                                    <field name="dosage"/>
                                    <field name="quantity"/>
                                    <field name="quantity_dispensed"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <field name="notes" placeholder="Notes for the pharmacy"/>
                        </page>
                        <page string="Dispensing" name="dispensing">
                            <field name="dispense_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="company_name" string="Pharmacy"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_prescription_action" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">medical.prescription</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="medical_dispense_view_list" model="ir.ui.view">
        <field name="name">medical.dispense.list</field>
        <field name="model">medical.dispense</field>
        <field name="arch" type="xml">
            <list string="Dispensing">
                <field name="name"/>
                <field name="date"/>
                <field name="prescription_id"/>
                <field name="patient_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="medical_dispense_view_form" model="ir.ui.view">
        <field name="name">medical.dispense.form</field>
        <field name="model">medical.dispense</field>
        <field name="arch" type="xml">
            <form string="Dispensing">
                <header>
                    <button name="action_done" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="prescription_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="patient_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="pharmacist_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="prescription_line_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_dispense_action" model="ir.actions.act_window">
        <field name="name">Dispensing</field>
        <field name="res_model">medical.dispense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
