<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trace_event_view_search" model="ir.ui.view">
        <field name="name">trace.event.search</field>
        <field name="model">trace.event</field>
        <field name="arch" type="xml">
            <search string="Events">
                <field name="batch_id"/>
                <field name="party_id"/>
                <field name="event_type"/>
                <group>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_party" string="Party" context="{'group_by': 'party_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="trace_event_view_list" model="ir.ui.view">
        <field name="name">trace.event.list</field>
        <field name="model">trace.event</field>
        <field name="arch" type="xml">
            <list string="Events" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="batch_id"/>
                <field name="sequence"/>
                <field name="event_type" widget="badge"/>
                <field name="party_id"/>
                <field name="user_id"/>
                <field name="location"/>
                <field name="quantity_delta"/>
            </list>
        </field>
    </record>

    <record id="trace_event_view_form" model="ir.ui.view">
        <field name="name">trace.event.form</field>
        <field name="model">trace.event</field>
        <field name="arch" type="xml">
            <form string="Event">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" options="{'no_create': True}" readonly="id"/>
                            <field name="event_type" readonly="id"/>
                            <field name="date" readonly="id"/>
                            <field name="location" readonly="id"/>
                            <field name="quantity_delta" readonly="id"/>
                        </group>
                        <group>
                            <field name="party_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="sequence" invisible="not id"/>
                            <field name="temperature" readonly="id"/>
                            <field name="humidity" readonly="id"/>
                            <field name="is_public" readonly="id"/>
                            <field name="corrects_event_id" readonly="id" invisible="event_type != 'correction'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" readonly="id"/>
                        <field name="attachment_ids" widget="many2many_binary" readonly="id"/>
                    </group>
                    <group string="Integrity" invisible="not id">
                        <field name="previous_hash"/>
                        <field name="hash"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="trace_event_action" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">trace.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
