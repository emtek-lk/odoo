<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_trace" model="ir.ui.view">
        <field name="name">res.partner.form.trace</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Supply Chain" name="trace" groups="trace_base.group_trace_user">
                    <group>
                        <field name="trace_role_ids" widget="many2many_tags" groups="trace_base.group_trace_manager"/>
                        <field name="trace_region"/>
                        <field name="trace_certifications"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="trace_party_action" model="ir.actions.act_window">
        <field name="name">Parties</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_trace_party', '=', True)]</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first party</p>
            <p>Parties are the farmers, harvesters, processors, transporters, distributors and retailers in the chain. Give them a role on the Supply Chain tab.</p>
        </field>
    </record>
</odoo>
