<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_trace">
        <field name="name">Supply Chain</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_trace_user" model="res.groups">
        <field name="name">Participant</field>
        <field name="sequence">10</field>
        <field name="comment">Acts for a party in the chain: records events on batches it holds and reads the history of batches that reached it.</field>
        <field name="privilege_id" ref="res_groups_privilege_trace"/>
    </record>
    <record id="group_trace_manager" model="res.groups">
        <field name="name">Chain Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Administers parties, roles and the catalog, and can read every batch.</field>
        <field name="implied_ids" eval="[(4, ref('group_trace_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_trace"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
