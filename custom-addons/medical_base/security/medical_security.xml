<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_medical_role">
        <field name="name">Medical Role</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record model="res.groups.privilege" id="res_groups_privilege_medical_admin">
        <field name="name">Medical Administration</field>
        <field name="sequence">51</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_medical_patient" model="res.groups">
        <field name="name">Patient</field>
        <field name="sequence">10</field>
        <field name="comment">Sees their own history, consents and who viewed their records.</field>
        <field name="privilege_id" ref="res_groups_privilege_medical_role"/>
    </record>
    <record id="group_medical_practitioner" model="res.groups">
        <field name="name">Practitioner</field>
        <field name="sequence">20</field>
        <field name="comment">Doctor: records encounters for their institution and reads patient data shared with them.</field>
        <field name="privilege_id" ref="res_groups_privilege_medical_role"/>
    </record>
    <record id="group_medical_manager" model="res.groups">
        <field name="name">Institution Manager</field>
        <field name="sequence">10</field>
        <field name="comment">Manages the practitioners, patients and access logs of their institutions.</field>
        <field name="privilege_id" ref="res_groups_privilege_medical_admin"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
