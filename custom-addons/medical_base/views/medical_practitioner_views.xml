<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_practitioner_view_list" model="ir.ui.view">
        <field name="name">medical.practitioner.list</field>
        <field name="model">medical.practitioner</field>
        <field name="arch" type="xml">
            <list string="Practitioners">
                <field name="name"/>
                <field name="specialty"/>
                <field name="licence_no"/>
                <field name="institution_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="medical_practitioner_view_form" model="ir.ui.view">
        <field name="name">medical.practitioner.form</field>
        <field name="model">medical.practitioner</field>
        <field name="arch" type="xml">
            <form string="Practitioner">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Dr. Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="specialty"/>
                            <field name="licence_no"/>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="institution_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_practitioner_action" model="ir.actions.act_window">
        <field name="name">Practitioners</field>
        <field name="res_model">medical.practitioner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
