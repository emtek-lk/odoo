<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_encounter_view_search" model="ir.ui.view">
        <field name="name">medical.encounter.search</field>
        <field name="model">medical.encounter</field>
        <field name="arch" type="xml">
            <search string="Encounters">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <filter name="mine" string="My Institution" domain="[('company_id', 'in', allowed_company_ids)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Institution" context="{'group_by': 'company_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="medical_encounter_view_list" model="ir.ui.view">
        <field name="name">medical.encounter.list</field>
        <field name="model">medical.encounter</field>
        <field name="arch" type="xml">
            <list string="Encounters">
                <field name="name"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="company_name" string="Institution"/>
                <field name="encounter_type"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="medical_encounter_view_form" model="ir.ui.view">
        <field name="name">medical.encounter.form</field>
        <field name="model">medical.encounter</field>
        <field name="arch" type="xml">
            <form string="Encounter">
                <header>
                    <button name="action_done" string="Finish" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="patient_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="practitioner_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="company_name" string="Institution"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="encounter_type" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical" name="clinical">
                            <group>
                                <field name="complaint" readonly="state != 'draft'"/>
                                <field name="diagnosis" readonly="state != 'draft'"/>
                            </group>
                            <field name="notes" readonly="state != 'draft'"/>
                        </page>
                        <page string="Addenda" name="addenda">
                            <field name="addendum_ids">
                                <list editable="bottom">
                                    <field name="note"/>
                                    <field name="author_id" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_encounter_action" model="ir.actions.act_window">
        <field name="name">Encounters</field>
        <field name="res_model">medical.encounter</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
