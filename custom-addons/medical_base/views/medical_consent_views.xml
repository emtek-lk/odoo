<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_consent_view_list" model="ir.ui.view">
        <field name="name">medical.consent.list</field>
        <field name="model">medical.consent</field>
        <field name="arch" type="xml">
            <list string="Consents">
                <field name="patient_id"/>
                <field name="grantee_name"/>
                <field name="scope"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="method"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state != 'active'"/>
            </list>
        </field>
    </record>

    <record id="medical_consent_view_form" model="ir.ui.view">
        <field name="name">medical.consent.form</field>
        <field name="model">medical.consent</field>
        <field name="arch" type="xml">
            <form string="Consent">
                <header>
                    <button name="action_revoke" string="Revoke" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,revoked,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" options="{'no_create': True}"/>
                            <field name="practitioner_id" options="{'no_create': True}"/>
                            <field name="grantee_company_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="method"/>
                            <field name="evidence_ids" widget="many2many_binary" invisible="method != 'in_person'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_consent_action" model="ir.actions.act_window">
        <field name="name">Consents</field>
        <field name="res_model">medical.consent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
