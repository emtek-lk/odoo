<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_access_log_view_list" model="ir.ui.view">
        <field name="name">medical.access.log.list</field>
        <field name="model">medical.access.log</field>
        <field name="arch" type="xml">
            <list string="Access Log" create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="accessor_company_id"/>
                <field name="patient_id"/>
                <field name="owner_company_id"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <record id="medical_access_log_action" model="ir.actions.act_window">
        <field name="name">Access Log</field>
        <field name="res_model">medical.access.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
