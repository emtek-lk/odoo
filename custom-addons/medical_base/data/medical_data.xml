<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_medical_patient" model="ir.sequence">
        <field name="name">Patient Code</field>
        <field name="code">medical.patient</field>
        <field name="prefix">MP</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_medical_encounter" model="ir.sequence">
        <field name="name">Encounter</field>
        <field name="code">medical.encounter</field>
        <field name="prefix">ENC/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="ir_cron_expire_consents" model="ir.cron">
        <field name="name">Medical: expire consents</field>
        <field name="model_id" ref="model_medical_consent"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_consents()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
