<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trace_process_view_list" model="ir.ui.view">
        <field name="name">trace.process.list</field>
        <field name="model">trace.process</field>
        <field name="arch" type="xml">
            <list string="Processing">
                <field name="name"/>
                <field name="date"/>
                <field name="process_type"/>
                <field name="description"/>
                <field name="party_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="trace_process_view_form" model="ir.ui.view">
        <field name="name">trace.process.form</field>
        <field name="model">trace.process</field>
        <field name="arch" type="xml">
            <form string="Processing">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="process_type" readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="location" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="party_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Inputs">
                            <field name="input_ids" nolabel="1" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="batch_id" options="{'no_create': True}"/>
                                    <field name="available"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </group>
                        <group string="Outputs">
                            <field name="output_ids" nolabel="1" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="batch_id"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="trace_process_action" model="ir.actions.act_window">
        <field name="name">Processing</field>
        <field name="res_model">trace.process</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first processing run</p>
            <p>Turn batches you hold into new batches (for example tomatoes into sauce), split one into several, or merge several into one. The new batches keep their lineage.</p>
        </field>
    </record>
</odoo>
